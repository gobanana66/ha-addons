# Google Health Fetch - local environment template
# Copy to .env and fill in your values:  cp .env.example .env
# Load before running:                   set -a; source .env; set +a
# Then:                                  python3 Google_Health_Fetch.py
#
# .env is gitignored; this .env.example is safe to commit.

# --- Local debug ---
# true  = fetch from Google Health but SKIP InfluxDB (summary + JSONL dump)
# false = write to InfluxDB as normal
DEBUG_LOCAL=true

# --- Google OAuth 2.0 credentials (from your Google Cloud project) ---
CLIENT_ID=your_google_oauth_client_id
CLIENT_SECRET=your_google_oauth_client_secret

# --- Fitbit credentials (only needed for parity_check.py side-by-side) ---
FITBIT_CLIENT_ID=your_fitbit_client_id
FITBIT_CLIENT_SECRET=your_fitbit_client_secret
FITBIT_TOKEN_FILE=./fitbit.token

# --- File paths (must be writable; defaults in the script are placeholders) ---
TOKEN_FILE_PATH=./google_health.token
FITBIT_LOG_FILE_PATH=./google_health.log
COLLECTED_RECORDS_FILE_PATH=./debug

# --- General ---
DEVICENAME=Charge6
# Set explicitly (Automatic falls back to UTC on the Google Health API)
LOCAL_TIMEZONE=Europe/Berlin

# --- Optional: weight sync to a Google Form ---
GOOGLE_FORM_URL=

# --- InfluxDB (only needed when DEBUG_LOCAL=false) ---
INFLUXDB_VERSION=2
# v2:
INFLUXDB_URL=http://localhost:8086
INFLUXDB_TOKEN=your_influxdb_token
INFLUXDB_ORG=your_org
INFLUXDB_BUCKET=your_bucket
# v1:
INFLUXDB_HOST=localhost
INFLUXDB_PORT=8086
INFLUXDB_USERNAME=
INFLUXDB_PASSWORD=
INFLUXDB_DATABASE=fitbit
